# Copy to deploy/.env and replace EVERY value. The API refuses to start in prod with dev secrets.
POSTGRES_PASSWORD=change-me-strong-db-password
# python -c "import secrets; print(secrets.token_urlsafe(48))"
GAZYAR_SECRET_KEY=
GAZYAR_BLIND_INDEX_KEY=
GAZYAR_OTP_PEPPER=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"  (newest first, comma-separated)
GAZYAR_FERNET_KEYS=
GAZYAR_SMS_PROVIDER=kavenegar
GAZYAR_SMS_API_KEY=
GAZYAR_SMS_SENDER=
GAZYAR_CORS_ORIGINS=https://gazyar.example.ir
GAZYAR_PUBLIC_BASE_URL=https://gazyar.example.ir
