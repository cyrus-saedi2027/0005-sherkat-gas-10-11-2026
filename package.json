{
  "name": "gazyar",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "dev:user": "pnpm --filter @gazyar/user dev",
    "dev:admin": "pnpm --filter @gazyar/admin dev",
    "build": "pnpm --filter @gazyar/user build && pnpm --filter @gazyar/admin build",
    "gen:api": "node scripts/gen-api.mjs",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.15.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "type": "module"
}
